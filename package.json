{
  "name": "tg-post-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:pg": "vitest run tests/postgresProjectRepository.integration.test.ts tests/postgresJobRepository.integration.test.ts",
    "smoke": "node dist/src/index.js --smoke",
    "test:telegram-smoke-contract": "python3 -m unittest scripts/telegram-e2e/test_tg_post_agent_smoke.py",
    "smoke:telegram": "python3 scripts/telegram-e2e/tg_post_agent_smoke.py"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "drizzle-orm": "^0.44.7",
    "grammy": "^1.36.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
