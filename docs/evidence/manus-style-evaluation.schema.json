{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tg-post-agent:manus-style-evaluation:v1",
  "title": "Content-free Manus style evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["pass", "hardGates", "metrics", "weightedStyleScore", "diagnostics", "categories"],
  "properties": {
    "pass": { "type": "boolean" },
    "hardGates": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "description": "Role PR/F1, density deviation, semantic-accent budget, and heading-case accuracy; numeric/category-only."
    },
    "weightedStyleScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactByteEquality", "sourceTokenCount", "candidateTokenCount", "goldFingerprint", "candidateFingerprint"],
      "properties": {
        "exactByteEquality": { "type": "boolean" },
        "sourceTokenCount": { "type": "integer", "minimum": 0 },
        "candidateTokenCount": { "type": "integer", "minimum": 0 },
        "goldFingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "candidateFingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" }
      }
    },
    "categories": {
      "type": "array",
      "items": { "type": "string", "pattern": "^MANUS_[A-Z0-9_]+$" },
      "uniqueItems": true
    }
  }
}
